DATABASE_URL=mysql+pymysql://root@localhost:3306/Smarthomes
SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# First date on which the system reliably collected complete booking records (YYYY-MM-DD).
ANALYTICS_COVERAGE_START_DATE=
# Forecast eligibility policy: verified observations required for baselines.
ANALYTICS_BASELINE_MIN_PERIODS=12
# ARIMA requires at least 24 training observations in this implementation.
ANALYTICS_ARIMA_MIN_TRAINING_PERIODS=24
# Minimum successful rolling-origin holdout folds required to select ARIMA.
ANALYTICS_ARIMA_MIN_VALIDATION_FOLDS=3
# Minimum MAE improvement over the best paired-fold baseline for ARIMA selection.
ANALYTICS_ARIMA_MIN_MAE_IMPROVEMENT_PERCENT=5
# Maximum acceptable WAPE for ARIMA selection.
ANALYTICS_ARIMA_MAX_WAPE_PERCENT=100
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
